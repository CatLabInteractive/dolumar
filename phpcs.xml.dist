<?xml version="1.0"?>
<ruleset name="Dolumar PHP 8.4 compatibility">
	<description>Checks the game code for PHP 8.4 compatibility.</description>
	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<config name="testVersion" value="8.4-"/>
	<rule ref="PHPCompatibility"/>
	<file>src</file>
	<file>bootstrap</file>
	<file>public</file>
	<file>cron</file>
	<file>tools</file>
</ruleset>
