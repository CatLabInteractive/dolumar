# Settings for tools/deploy.sh. Copy to tools/deploy.env (not committed) and edit.
# This file is sourced by bash: a value with spaces MUST be quoted, or bash runs the second word as a command.

# Dokku server (the user is always dokku).
DOLUMAR_DOKKU_HOST=dokku@YOUR_SERVER

# The apps, in deploy order. Keep the long-running world last.
DOLUMAR_APPS="dolumar-speed dolumar-classic dolumar"
