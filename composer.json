{
  "name": "catlabinteractive/dolumar",
  "license" : "GPL-3.0",

  "require": {
    "php": "^8.4.27",
    "catlabinteractive/dolumar-engine" : "dev-php8",
    "airbrake/phpbrake": "^0.8",
    "vlucas/phpdotenv": "^5.6",

    "ext-memcached" : "*",
    "ext-mysqli": "*",
    "ext-gd": "*",
    "ext-bcmath" : "*",
    "ext-mbstring": "*"
  },

  "repositories": [
    {
      "type": "vcs",
      "url":  "https://github.com/CatLabInteractive/dolumar-engine.git"
    }
  ],

  "autoload" : {
    "classmap" : [
      "src"
    ]
  },

  "require-dev": {
    "phpunit/phpunit": "^11",
    "squizlabs/php_codesniffer": "^3.10",
    "phpcompatibility/php-compatibility": "^10@dev"
  },

  "minimum-stability" : "dev",
  "prefer-stable" : true,

  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
