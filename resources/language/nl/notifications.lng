[battle]
attacking="@@actor zendt zijn troepen van @@village om @@defender (@@pl_defender) aan te vallen."
defending="Jouw dorp @@village wordt aangevallen door @@attacker (@@pl_attacker)."
fought_attacker = "Je leger uit @@village heeft gevochten bij @@target. Bekijk je gevechtsrapporten."
fought_defender = "@@attacker heeft je dorp @@village aangevallen. Bekijk je gevechtsrapporten."
returned = "Je leger is terug thuis in @@village."

[messages]
received="Je hebt een bericht ontvangen van @@player."

[runes]
received="Je hebt @@runes ontvangen van @@player."

[resources]
received="Je hebt @@resources ontvangen van @@player."

[system]
test="Dit is een test notificatie. Je proefkonijn was @@user."

[clan]
join="@@actor is lid geworden van clan @@clan."
leave="@@actor is geen lid meer van clan @@clan."

[portal]
open="@@player heeft een magische poort geöpend tussen @@village en @@target_village. Hij zal open blijven tot @@date en is beschikbaar voor alle clanleden."
opened="@@player heeft een magische poort geöpend tussen @@village en @@target_village. Hij zal open blijven tot @@date en is beschikbaar voor alle clanleden."

[bonusbuilding]
build="@@actor heeft een @@building gekocht voor @@village."

[building]
ready = "Je @@building in @@village is klaar."
upgraded = "Je @@building in @@village is nu niveau @@level."

[categories]
battle = "Aanvallen en gevechten"
building = "Afgewerkte gebouwen"
resources = "Ontvangen grondstoffen"
runes = "Ontvangen runen"
equipment = "Ontvangen uitrusting"
portal = "Clanportalen"
