[neverending]
title = "Diese Welt endet nie"
welcome = "Diese Welt hat kein Endspiel. Kein Clan kann sie gewinnen, die Runde endet nie und die Welt wird nie zurückgesetzt. Spiele so lange, wie es dir Spaß macht, aber hier gibt es nichts zu gewinnen."
ranking = "Die Ranglisten dienen nur dem Ruhm. Diese Welt hat kein Endspiel und keinen Sieger."
register = "Bevor du beginnst: Diese Welt läuft schon seit Jahren und hat kein Endspiel. Niemand kann sie gewinnen und sie wird nie zurückgesetzt, daher sind dir die Spieler, die schon hier sind, weit voraus."
serversettings = "Diese Welt hat kein Endspiel. Sie endet nie und wird nie zurückgesetzt."
