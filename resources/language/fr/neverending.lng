[neverending]
title = "Ce monde ne finit jamais"
welcome = "Ce monde n'a pas de fin de partie. Aucun clan ne peut le gagner, la manche ne se termine jamais et le monde n'est jamais réinitialisé. Jouez aussi longtemps que cela vous plaît, mais il n'y a rien à gagner ici."
ranking = "Les classements ne servent qu'à la gloire. Ce monde n'a ni fin de partie ni vainqueur."
register = "Avant de commencer : ce monde existe depuis des années et n'a pas de fin de partie. Personne ne peut le gagner et il n'est jamais réinitialisé, les joueurs déjà présents ont donc une grande avance sur vous."
serversettings = "Ce monde n'a pas de fin de partie. Il ne se termine jamais et n'est jamais réinitialisé."
