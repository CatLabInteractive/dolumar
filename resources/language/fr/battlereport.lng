[casualties_error]
1="@@amount unités sont mortes dans l'attaque de @@attacker contre @@defender. ERREUR !!!"

[casualties_melee]
1="@@attacker tuent @@amount unités de @@defender en mêlée."

[casualties_shooting]
1="Une salve bien ajustée de @@attacker tue @@amount unités de @@defender."
2="@@attacker ne se repose pas sur ses lauriers et tue @@amount unités de @@defender."

[flee]
1="Les @@unit fuient en hurlant et en pleurant. Je vous avais bien dit que tout cela se terminerait dans les larmes."
2="Les @@unit choisissent stratégiquement de quitter le champ de bataille."
3="Les @@unit battent en retraite."
4="Les @@unit fuient le champs de bataille."

[move]
1="Les @@unit se déplacent de la position @@from à @@to."
2="Les @@unit tombent sur une araignée et s'enfuient à la position @@to."
3="Les @@unit avancent sur la position @@to."

[specialunitdied]
1="Les @@unit de niveau @@level meurent."

[status_0]
1="Les magiciens se préparent au  combat."

[introtext]
1="Le sol tremble sous la marche des armées prêtent à se battre. Les paysans de @@defender fuient en hurlant pendant que les armées de @@attacker envahissent leurs terres."

[status_1]
1="Soudain, vôtre capitaine s'aperçoit que les archers ennemis se mettent place. Rapidement, il ordonne à vos archers de faire feu !"

[status_2]
1="Votre capitaine ordonne à vos troupes de charger vos ennemis !"

[status_3]
1="Une rivière de sang noie le champ de bataille. Et alors que le soleil se couche, votre capitaine jette un dernier regard sur le champ de bataille, couvert de soldats blessés et morts. Le bataille est terminée... mais qu'en est il de la guerre ?"
2="Le combat est terminée."

[stunned]
1="Les @@unit sont sonnés et ne peuvent pas attaquer leurs cibles."

[whipe]
1="Les corps sans vie des @@unit gisent à même le champ de bataille."


[log_move]
1 = "@@unit prennent position (@@terrain)."
2 = "@@unit marchent vers un nouvel emplacement (@@terrain)."

[log_stunned]
1 = "@@unit ne peuvent pas agir."

[log_shooting]
1 = "@@attacker tirent sur @@defender."
2 = "Une salve de @@attacker frappe @@defender."

[log_melee]
1 = "@@attacker combattent @@defender."
2 = "@@attacker chargent @@defender."
3 = "@@attacker se heurtent à @@defender."

[log_fled]
1 = "@@unit cèdent et fuient."
2 = "@@unit quittent le champ de bataille."

[log_wiped]
1 = "@@unit sont anéantis."
2 = "Les derniers de @@unit tombent."

[log_magedied]
1 = "@@unit (niveau @@level) est mort."

[moment_volley]
1 = "@@attacker ont abattu @@amount de @@defender."

[moment_fled]
1 = "@@unit ont cédé et fui. Leur ligne s'est effondrée."

[moment_wiped]
1 = "@@unit ont été anéantis jusqu'au dernier."

[moment_loss]
1 = "@@attacker ont tué @@amount de @@defender."

[chronicle_intro]
1 = "La terre trembla quand l'armée de @@attacker marcha sur @@defender."
2 = "La poussière s'éleva au-dessus des champs de @@defender quand l'armée de @@attacker apparut."
3 = "Les cors sonnèrent à @@defender : l'armée de @@attacker était arrivée."

[chronicle_magic]
1 = "Avant même qu'une flèche ne vole, @@unit lança @@spell."

[chronicle_magicfailed]
1 = "@@unit tenta de lancer @@spell, mais le sort ne donna rien."

[chronicle_volley]
1 = "@@unit tirèrent les premiers, et @@amount ennemis tombèrent avant de pouvoir lever leurs boucliers."
2 = "Un nuage de flèches de @@unit obscurcit le ciel ; @@amount ennemis tombèrent."

[chronicle_volley_total]
1 = "Au total, la salve coûta @@attlost à @@attacker et @@deflost à @@defender."

[chronicle_novolley]
1 = "Aucune flèche ne vola. Les deux armées se ruèrent directement l'une sur l'autre."

[chronicle_melee]
1 = "Puis les lignes se heurtèrent. @@unit se battirent le plus durement et abattirent @@amount ennemis."
2 = "L'acier rencontra l'acier. Personne ne se battit plus durement que @@unit, qui abattirent @@amount ennemis."

[chronicle_broke_fled]
1 = "@@unit cédèrent et s'enfuirent."
2 = "@@unit perdirent courage et prirent la fuite."

[chronicle_broke_wiped]
1 = "@@unit furent anéantis jusqu'au dernier."
2 = "Pas un seul de @@unit ne quitta le champ vivant."

[chronicle_end_win]
1 = "À la fin, les défenseurs de @@defender ne purent tenir plus longtemps."
2 = "Quand la poussière retomba, @@defender était à la merci de @@attacker."

[chronicle_end_loss]
1 = "À la fin, l'armée de @@attacker fit demi-tour, vaincue."
2 = "Les murs de @@defender tinrent bon, et l'armée de @@attacker se retira."

[chronicle_spoils]
1 = "Les chariots rentrèrent chargés : @@resources ressources et @@runes runes."

[chronicle_nospoils]
1 = "Rien n'a été pris."

[chronicle_verdict_win]
1 = "Une victoire à @@percent%. @@hero a remporté la journée."

[chronicle_verdict_loss]
1 = "L'attaque a été repoussée. @@hero a tenu la ligne."

[chronicle_verdict_plain]
1 = "Une victoire à @@percent%."
