# Required
DATABASE_URL=mysql://user:password@host:3306/dolumar
# Memcached is required (the map depends on it). dokku-memcached sets MEMCACHED_URL.
MEMCACHED_URL=memcached://localhost:11211
# Public URL of the game, with trailing slash; PROTOCOL is http or https
ABSOLUTE_URL=
PROTOCOL=https

# Optional: general
APP_DEBUG=
# Cache-busting version for scripts and stylesheets; defaults to the deployed git commit (GIT_REV on Dokku)
APP_VERSION=
CACHE_DIR=/tmp/dolumar
# Directory for custom sign images (default: public/signs); must be persistent
# SIGNS_PATH=
DB_CHARSET=utf8mb4
NOLOGIN_REDIRECT=
# Reverse proxies trusted to pass the visitor's IP in X-Forwarded-For (comma separated CIDR ranges).
# Default: 127.0.0.0/8, ::1/128, 172.16.0.0/12 (Dokku's nginx on the Docker bridge).
# TRUSTED_PROXIES=
WIKI_GUIDE_URL=

# Optional: let players pay credits to speed up buildings, training or scouting.
# Off unless set to 1/true.
PREMIUM_SPEEDUP_BUILDINGS=
PREMIUM_SPEEDUP_TRAINING=
PREMIUM_SPEEDUP_SCOUTING=

# Optional: set to 1 for a never-ending world. Disables the endgame (no Dor Daedeloth spell, no
# winner, no reset) and tells players in game that this world cannot be won.
NEVERENDING=

# Optional: NPC tribes. NPC_AGGRESSION is off, counter (default) or full.
NPC_AGGRESSION=
NPC_PROTECTION_RUNES=

# Preview instances only (one per pull request, see README "Pull request previews"). NEVER set in production:
# it enables /preview-login.php (log in as anyone) and tools/seed.php.
PREVIEW_MODE=
# Number of test players tools/seed.php creates (default 12)
SEED_PLAYERS=

# Optional: legacy memcached providers (used when MEMCACHED_URL is unset)
MEMCACHIER_SERVERS=
MEMCACHIER_USERNAME=
MEMCACHIER_PASSWORD=

# Optional: error reporting
# Airbrake-compatible error tracker (e.g. https://errors.catlab.eu); errors are always logged too
AIRBRAKE_HOST=
AIRBRAKE_PROJECT_ID=
AIRBRAKE_TOKEN=
# Shown in the tracker to tell instances apart, e.g. production (previews get preview-<name>)
AIRBRAKE_ENVIRONMENT=

# Optional: email
EMAIL_FROM=
EMAIL_FROM_NAME=
EMAIL_DEBUG_LEVEL=
EMAIL_SMTP_SERVER=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_SECURE=

# OpenID Connect login
OPENID_CONNECT_AUTHORIZE_URL=
OPENID_CONNECT_TOKEN_URL=
OPENID_CONNECT_PROFILE_URL=
OPENID_CONNECT_PROFILE_URL_PREFIX=
OPENID_CONNECT_CLIENT_ID=
OPENID_CONNECT_SECRET=
# CatLab Accounts credits. Credits (and every purchase link) are enabled only when
# OPENID_CONNECT_CLIENT_ID, OPENID_CONNECT_SECRET and CATLAB_CREDITS_TYPE_ID are all set.
# OPENID_CONNECT_PROFILE_URL_PREFIX (above) is also required when credits are enabled.
# Id of the "Dolumar credits" credit type created in the Accounts admin.
CATLAB_CREDITS_TYPE_ID=
# Optional, defaults to https://accounts.catlab.eu/
CATLAB_ACCOUNTS_URL=

# Optional: browser (Web Push) notifications. Off unless both keys are set.
# Generate once with `php tools/vapid-keys.php` and never change them afterwards:
# a new pair silently breaks every player's existing subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services (mailto: or https:). Defaults to mailto:EMAIL_FROM.
VAPID_SUBJECT=

# Dead services: leave these unset. The game works without them and makes no
# outgoing calls to the credits server or the serverlist.
CREDITS_GAME_TOKEN=
CREDITS_PRIVATE_KEY=
SERVERLIST_URL=
SERVERLIST_VISIBLE=
SERVERLIST_PRIVATE_KEY=
SERVERLIST_PUBLIC_KEY=
